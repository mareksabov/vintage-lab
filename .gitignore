# Never commit machine media or persistent state (may include copyrighted images).
# Ignore the *contents* (not the dirs themselves) so the .gitkeep placeholders
# survive — a bare `**/media/` would exclude the dir and defeat the negations.
**/media/*
**/state/*
!**/media/.gitkeep
!**/state/.gitkeep

# Python
__pycache__/
*.pyc
.pytest_cache/

# Nix / direnv build artifacts and caches
result
roms-result
.direnv/

# Local agent/workflow scratch (briefs, ledgers, review packages)
.superpowers/
